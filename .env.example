# =============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO: mfe1_comandos_frontend (Sala de Crisis Remoto)
# Copia este archivo a .env y ajusta las URLs según tu entorno de despliegue
# =============================================================================

# Cambiar a false cuando desees probar la integración con los microservicios reales
USE_MOCKS=true

# Endpoints Microservicio MS-01 (NestJS Comandos y SAGA de Despacho)
API_MS1_URL=http://localhost:3000/api/v1
WS_SALA_CRISIS_URL=http://localhost:3000/ws/sala-crisis

# Endpoints Microservicio MS-05 (FastAPI IA Multimodal y Voice-to-Report)
API_MS5_URL=http://localhost:8005/api/v1

# Endpoints de Referencia de Compañeros
API_MS2_FLOTAS_URL=http://localhost:8082/api/v1
API_MS3_GRAPHQL_URL=http://localhost:8003/graphql
